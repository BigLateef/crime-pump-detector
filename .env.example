# ---- App ----
APP_NAME="Crime Pump Early Detector"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-64-char-random-string
ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://cped:cped@postgres:5432/cped
# Managed providers (Neon, Supabase, etc.) require TLS - set true against
# those. Local Docker Compose Postgres doesn't need it, so false here.
DATABASE_SSL_REQUIRED=false
POSTGRES_USER=cped
POSTGRES_PASSWORD=cped
POSTGRES_DB=cped

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- Invite system ----
INVITE_CODE_LENGTH=9

# ---- Discord (encrypted at rest; never logged) ----
DISCORD_WEBHOOK_ENCRYPTION_KEY=change-me-32-byte-key

# ---- Discord alert delivery (send every valid signal, not just
# high-score ones - see HANDOFF.md "Discord alerts without score
# filtering" section) ----
# When true, every valid signal the scanner constructs gets a Discord
# delivery regardless of score, and DISCORD_ALERT_MIN_SCORE is ignored
# entirely. Each destination's own per-integration minimum_score
# (set in Settings > Discord alerts) is also ignored while this is on.
DISCORD_ALERT_ALL_SIGNALS=false
# Only used as the default minimum_score for newly-created Discord
# destinations, and only while DISCORD_ALERT_ALL_SIGNALS=false. Does not
# retroactively change destinations that already have their own value set.
DISCORD_ALERT_MIN_SCORE=55
# Discord-delivery-specific cooldown, separate from ALERT_COOLDOWN_MINUTES
# above (which governs whether a signal gets created at all). This one
# additionally rate-limits Discord delivery itself per (token, alert
# type), preventing a token oscillating near a score boundary from
# re-alerting on every scan pass once DISCORD_ALERT_ALL_SIGNALS is on.
DISCORD_ALERT_COOLDOWN_MINUTES=30

# ---- Background worker / low-cost controls (Section 13) ----
SCANNER_INTERVAL_SECONDS=60
HIGH_ACTIVITY_SCAN_INTERVAL_SECONDS=15
LOW_ACTIVITY_SCAN_INTERVAL_SECONDS=300
SOCIAL_SCAN_INTERVAL_SECONDS=900
MAX_TOKENS_PER_BATCH=50
MAX_API_REQUESTS_PER_MINUTE=60
ALERT_COOLDOWN_MINUTES=30
ENABLE_SOCIAL_ANALYSIS=false
ENABLE_AI_ANALYSIS=false
LOW_COST_MODE=true

# ---- Safety switches ----
DRY_RUN=true
ENABLE_LIVE_DATA=false

# ---- Cron trigger (external scheduler pings this instead of running an
# always-on worker process — see HANDOFF.md worker-cost section) ----
SCAN_TRIGGER_SECRET=change-me-to-a-random-string

# ---- Live data providers ----
DATA_PROVIDER_MODE=mock
DEXSCREENER_ENABLED=false
GOPLUS_ENABLED=false
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest/dex
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1/token_security
DATA_CACHE_TTL_SECONDS=30
DATA_REQUEST_TIMEOUT_SECONDS=10
DATA_MAX_RETRIES=3

# ---- Uvicorn (used by scripts/start_prod.sh; not read directly by
# docker-compose's local dev command, which hardcodes --reload) ----
UVICORN_WORKERS=2
