# Production values for the backend. Set these as real environment
# variables on your deployment platform (Railway/Render/Fly/etc secrets
# manager) - never commit an actual .env.production file, and never put
# a real secret in a file that could end up in version control.

# ---- App ----
APP_NAME="Crime Pump Early Detector"
APP_ENV=production
DEBUG=false
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_REAL_GENERATED_SECRET
# Exact deployed frontend origin(s), comma-separated. Never "*" - see
# DEPLOYMENT.md's CORS section for why that's not just a style choice.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Database (managed Postgres - Neon, Supabase, RDS, etc.) ----
# Get this from your provider's dashboard. Must use the asyncpg driver
# prefix (postgresql+asyncpg://), not the bare postgresql:// most
# providers show by default.
DATABASE_URL=postgresql+asyncpg://user:password@your-host.neon.tech/dbname
DATABASE_SSL_REQUIRED=true

# ---- Redis (managed - Upstash, etc.) ----
REDIS_URL=rediss://default:REPLACE_WITH_REAL_PASSWORD@your-instance.upstash.io:6379

# ---- Auth ----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---- Invite system ----
INVITE_CODE_LENGTH=9

# ---- Discord ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_A_REAL_GENERATED_KEY

# ---- Discord alert delivery (send every valid signal, not just
# high-score ones) - see DEPLOYMENT.md section 8 ----
# false (default) = each Discord destination's own minimum_score gates
# delivery, same as always. true = every valid signal is delivered
# regardless of score, and DISCORD_ALERT_MIN_SCORE / each destination's
# own minimum_score are both ignored while this is on.
DISCORD_ALERT_ALL_SIGNALS=false
# Default minimum_score assigned to newly-created Discord destinations
# (only takes effect while DISCORD_ALERT_ALL_SIGNALS=false).
DISCORD_ALERT_MIN_SCORE=55
# Discord-delivery-specific cooldown, separate from ALERT_COOLDOWN_MINUTES
# below (which governs signal creation, not Discord delivery).
DISCORD_ALERT_COOLDOWN_MINUTES=30

# ---- Background worker / low-cost controls ----
# Keep LOW_COST_MODE=true in production unless you have a specific,
# monitored reason to disable it - see README.md's Low-cost mode section.
SCANNER_INTERVAL_SECONDS=60
HIGH_ACTIVITY_SCAN_INTERVAL_SECONDS=15
LOW_ACTIVITY_SCAN_INTERVAL_SECONDS=300
SOCIAL_SCAN_INTERVAL_SECONDS=900
MAX_TOKENS_PER_BATCH=50
MAX_API_REQUESTS_PER_MINUTE=60
ALERT_COOLDOWN_MINUTES=30
ENABLE_SOCIAL_ANALYSIS=false
ENABLE_AI_ANALYSIS=false
LOW_COST_MODE=true

# ---- Safety switches ----
# Flip these deliberately, one at a time, only after the live adapters
# have been verified against the real APIs - see README.md's DEMO vs
# VERIFIED section and scripts/smoke_test.sh.
DRY_RUN=false
ENABLE_LIVE_DATA=true

# ---- Scheduler (cron-job.org calls this) ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCAN_TRIGGER_SECRET=REPLACE_WITH_A_REAL_GENERATED_SECRET

# ---- Live data providers ----
DATA_PROVIDER_MODE=live
DEXSCREENER_ENABLED=true
GOPLUS_ENABLED=true
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest/dex
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1/token_security
DATA_CACHE_TTL_SECONDS=30
DATA_REQUEST_TIMEOUT_SECONDS=10
DATA_MAX_RETRIES=3

# ---- Uvicorn ----
UVICORN_WORKERS=2
