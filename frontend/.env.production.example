# Production values for Vercel. Set these as Vercel Environment Variables
# (Project Settings -> Environment Variables), scoped to "Production" —
# never commit a real .env.production file.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time
# and are visible to anyone who opens devtools — never put a secret in
# one. The backend URL is not sensitive; it's a public API endpoint.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
